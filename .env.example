# =============================================================================
# Tarsee — Environment Variables
# Copy this to .env for local dev, or set in Railway's Variables tab.
# =============================================================================

# --- Required ---
NODE_ENV=production
SETUP_PASSWORD=your-password-here
ENCRYPTION_KEY=                          # Generate with: openssl rand -hex 32

# --- Claude Code Auth (Required) ---
# Get this from your local machine:
#   macOS:  security find-generic-password -s "Claude Code-credentials" -w
#   Linux:  cat ~/.claude/.credentials.json
CLAUDE_OAUTH_CREDENTIALS={"claudeAiOauth":{"accessToken":"sk-ant-oat01-...","refreshToken":"sk-ant-ort01-...","expiresAt":0},"organizationUuid":"..."}

# --- Claude Code Settings (Optional) ---
CLAUDE_DEFAULT_MODEL=claude-opus-4-6     # Options: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
# CLAUDE_WORKSPACE_DIR=/data/tarsee      # Auto-detected on Railway
# CLAUDE_CONFIG_DIR=/data/.claude         # Auto-detected on Railway

# --- Voice (Optional) ---
# ELEVENLABS_API_KEY=                     # ElevenLabs TTS (optional, for voice mode)
# OPENAI_API_KEY=                         # OpenAI Whisper STT (optional, for voice input)

# --- Channel Bot Tokens (Optional — configure in Settings UI instead) ---
# These can also be set via the web UI at Settings > Channels.
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# --- Railway (Auto-set by Railway, do not change) ---
# TARSEE_STATE_DIR=/data/tarsee
# TARSEE_WORKSPACE_DIR=/data/tarsee/workspace
# TARSEE_DATA_DIR=/data/tarsee/data
