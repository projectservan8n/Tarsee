# Required
SETUP_PASSWORD=
ENCRYPTION_KEY=

# --- Optional tuning (all have safe defaults; set in Railway variables) ---

# Abandon a turn after this long with NO stream event. Default 20 min.
# Was a hard 3 min, which killed long research/tool turns. Keep it FINITE —
# there is no PTY liveness watchdog on this engine to catch a wedged turn.
TARSEE_CHANNEL_IDLE_ABORT_MS=

# Claude session transcript (.jsonl) size cap in MB. Past this, the next turn
# starts a FRESH session instead of resuming the bloat — this is what prevents
# context-bloat hangs. Surfaced in Settings -> Token Health. Default 8.
TARSEE_SESSION_JSONL_MAX_MB=

# Override the assumed model context window (tokens) in Token Health.
# Default: read from the model registry (1M for Opus/Sonnet, 200k for Haiku).
TARSEE_MODEL_CONTEXT_TOKENS=

# Login session lifetime in days. Sessions persist to SQLite, so they now
# survive restarts and redeploys. Default 30.
TARSEE_SESSION_MAX_AGE_DAYS=

# CSRF token lifetime in hours. Default 24. (Was a hard 2h, which broke any
# browser tab left open longer than that.)
TARSEE_CSRF_MAX_AGE_HOURS=

# How often the channel-health watchdog probes for a wedged Telegram poller,
# in ms. Default 60000.
TARSEE_CHANNEL_HEALTH_MS=

# Set to 1 to restore the old behaviour of wiping every claude session id on
# boot. Off by default — wiping made conversations forget on every redeploy.
TARSEE_CLEAR_SESSIONS_ON_BOOT=

# Set to 1 to auto-update the Claude Code CLI on boot (adds ~60s to boot).
TARSEE_AUTO_UPDATE_CLI=
