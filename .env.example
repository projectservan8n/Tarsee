# Tarsee's variables, by name only. Put the values in Railway (your service > Variables), or in a .env file next to
# docker-compose.yml that you never commit. Never write a real key into this file.

# Required
# The 4-digit PIN for the web UI.
SETUP_PASSWORD=
# Encrypts what Tarsee stores: keys saved in Settings > AI, channel tokens, the vault. Make one with
# `openssl rand -hex 32`, and set it before you save any key in Settings (without it, one is made on the volume).
ENCRYPTION_KEY=

# --- Choose your AI (all optional: the setup wizard and Settings > AI do the same) ---
# Keys saved in Settings > AI are stored encrypted; a key set here as a variable works too (Settings wins when both
# have one). Each key only ever goes to its own provider. Step-by-step guide for every AI: docs/providers.md
# A command the agent runs can still read these keys on the server (it runs as the same user as Tarsee), so give
# every key a spending limit at its provider: that is the real guard.

# The default AI when Settings hasn't chosen one: claude, anthropic, chatgpt, openai, openrouter, deepseek or local.
TARSEE_AI_PROVIDER=
# Its model when Settings hasn't chosen one (for example sonnet, or deepseek-flash). Empty: that AI's default (for
# Local AI, the first model its server lists; set this to pin one).
TARSEE_AI_MODEL=
# 1 keeps "Only use API keys" on: no Claude or ChatGPT plan sign-in is ever used. For a Tarsee other people talk to.
TARSEE_KEYS_ONLY=
# Anthropic API key (starts sk-ant-api) from platform.claude.com: Claude billed per use. The Claude plan ignores it.
ANTHROPIC_API_KEY=
# OpenAI API key (starts sk-proj-) from platform.openai.com: billed per use. Voice uses it only if you pick Whisper API.
OPENAI_API_KEY=
# OpenRouter key (starts sk-or-v1-) from openrouter.ai: hundreds of models, one key. Give the key a credit limit.
OPENROUTER_API_KEY=
# DeepSeek API key from platform.deepseek.com: the cheapest per message, spent from a balance you top up.
DEEPSEEK_API_KEY=
# Local AI: your Ollama or LM Studio server's address, e.g. http://localhost:11434/v1 or http://ollama.railway.internal:11434/v1
TARSEE_LOCAL_AI_URL=
# Local AI's key, only if your server asks for one. It is only ever sent to TARSEE_LOCAL_AI_URL.
TARSEE_LOCAL_AI_KEY=
# The Claude plan without the Terminal: the token `claude setup-token` prints (it lasts a year). Claude plan only.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional tuning (all have safe defaults; set in Railway variables) ---

# Abandon a turn after this long with NO stream event. Default 20 min.
# Was a hard 3 min, which killed long research/tool turns. Keep it FINITE —
# there is no PTY liveness watchdog on this engine to catch a wedged turn.
TARSEE_CHANNEL_IDLE_ABORT_MS=

# Claude session transcript (.jsonl) size cap in MB. Past this, the next turn
# starts a FRESH session instead of resuming the bloat — this is what prevents
# context-bloat hangs. Surfaced in Settings -> Token Health. Default 8.
TARSEE_SESSION_JSONL_MAX_MB=

# Override the assumed model context window (tokens) in Token Health.
# Default: read from the model registry (1M for Opus/Sonnet, 200k for Haiku).
TARSEE_MODEL_CONTEXT_TOKENS=

# Login session lifetime in days. Sessions persist to SQLite, so they now
# survive restarts and redeploys. Default 30.
TARSEE_SESSION_MAX_AGE_DAYS=

# CSRF token lifetime in hours. Default 24. (Was a hard 2h, which broke any
# browser tab left open longer than that.)
TARSEE_CSRF_MAX_AGE_HOURS=

# How often the channel-health watchdog probes for a wedged Telegram poller,
# in ms. Default 60000.
TARSEE_CHANNEL_HEALTH_MS=

# Set to 1 to restore the old behaviour of wiping every claude session id on
# boot. Off by default — wiping made conversations forget on every redeploy.
TARSEE_CLEAR_SESSIONS_ON_BOOT=

# Set to 1 to auto-update the Claude Code CLI on boot (adds ~60s to boot).
TARSEE_AUTO_UPDATE_CLI=
