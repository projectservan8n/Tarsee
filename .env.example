# Tarsee — Environment Variables
# Set these in Railway's Variables tab. That's it — everything else is auto-detected or managed via Settings UI.

NODE_ENV=production
SETUP_PASSWORD=1234                      # 4-digit PIN (mobile login uses an iOS-style keypad)
ENCRYPTION_KEY=                          # Generate with: openssl rand -hex 32
TARSEE_STATE_DIR=/data/tarsee            # Railway volume mount path

# Claude credentials: NOT set via env var.
# After deploying, open the web terminal and run: claude login
