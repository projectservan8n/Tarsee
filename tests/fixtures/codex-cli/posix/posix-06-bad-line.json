{
  "name": "posix-06-bad-line",
  "what": "A stdout line that is not JSON: the SDK throws, and on its way out sends the program SIGTERM (the stub, which would have lived 30 s, logs it).",
  "made_with": {
    "sdk": "@openai/codex-sdk 0.167.0, called directly",
    "platform": "linux (WSL)",
    "node": "v22.22.2"
  },
  "sdk": {
    "new Codex(options)": {
      "env": {
        "PATH": "/usr/bin:/bin"
      },
      "codexPathOverride": "<CODEX_BIN>"
    },
    "callerProcessEnvNames": [
      "FROM_PROCESS_ENV",
      "PATH",
      "TARSEE_STATE_DIR"
    ]
  },
  "child": {
    "argv": [
      "exec",
      "--experimental-json"
    ],
    "cwd": "<CALLER_CWD>",
    "envNames": [
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
      "PATH"
    ],
    "envValues": {
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE": "codex_sdk_ts",
      "PATH": "/usr/bin:/bin"
    },
    "processGroup": {
      "sameGroupAsTheCaller": true,
      "sameSessionAsTheCaller": true,
      "isItsOwnGroupLeader": false
    },
    "stdin": {
      "chunks": [
        {
          "at_ms": 5,
          "bytes": 5
        }
      ],
      "eof_at_ms": 5,
      "bytes": 5,
      "text": "hello"
    }
  },
  "stub": {
    "stdout": "{\"type\":\"thread.started\",\"thread_id\":\"01a1c000-0000-7000-8000-0000000000cc\"}\nnot json\n",
    "stderr": "",
    "exitCode": 0,
    "staysAliveMs": 30000,
    "ignoresSignals": false
  },
  "sdkYielded": [
    "thread.started"
  ],
  "sdkThrew": {
    "name": "Error",
    "message": "Failed to parse item: not json",
    "code": null
  },
  "timing": {
    "iterationEndedAt_ms": 51
  },
  "signalsTheStubReceived": [
    {
      "stubClock_ms": 15,
      "signal": "SIGTERM"
    }
  ],
  "stubStillRunningAfterwards": false
}
