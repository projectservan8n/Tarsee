{
  "name": "sdk-07-pinned-binary-legacy-layout",
  "what": "The older layout the SDK still accepts: vendor/<triple>/codex/codex(.exe), with vendor/<triple>/path put first on PATH. No env option, so PATH is the caller's own with that folder in front.",
  "made_with": {
    "sdk": "@openai/codex-sdk 0.167.0, called directly",
    "platform": "win32"
  },
  "sdk": {
    "new Codex(options)": {},
    "thread": {
      "method": "startThread"
    },
    "runStreamed(input, turnOptions)": {
      "input": "hello",
      "inputLength": {
        "characters": 5,
        "utf8Bytes": 5
      },
      "turnOptions": {}
    },
    "callerProcessEnvNames": [
      "COMSPEC",
      "FROM_PROCESS_ENV",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP",
      "TMP",
      "TMPDIR"
    ]
  },
  "child": {
    "program": "<NODE_MODULES>\\@openai\\codex-win32-x64\\vendor\\x86_64-pc-windows-msvc\\codex\\codex.exe",
    "argv": [
      "exec",
      "--experimental-json"
    ],
    "cwd": "<CALLER_CWD>",
    "envNames": [
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
      "COMSPEC",
      "FROM_PROCESS_ENV",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP",
      "TMP",
      "TMPDIR"
    ],
    "envValues": {
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE": "codex_sdk_ts",
      "FROM_PROCESS_ENV": "the caller's own environment",
      "PATH": "<NODE_MODULES>\\@openai\\codex-win32-x64\\vendor\\x86_64-pc-windows-msvc\\path;C:\\WINDOWS\\system32;C:\\WINDOWS"
    },
    "stdin": {
      "text": "hello",
      "sameAsTheInput": true,
      "bytes": 5,
      "chunks": [
        {
          "at_ms": 0,
          "bytes": 5
        }
      ],
      "eof_at_ms": 0
    }
  },
  "stub": {
    "stdout": "{\"type\":\"thread.started\",\"thread_id\":\"01a1c000-0000-7000-8000-0000000000bb\"}\n{\"type\":\"turn.started\"}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_0\",\"type\":\"agent_message\",\"text\":\"ok\"}}\n{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":10,\"cached_input_tokens\":0,\"output_tokens\":2,\"reasoning_output_tokens\":0}}\n",
    "stderr": "",
    "exitCode": 0,
    "sleepMsBeforeExit": 0
  },
  "sdkYielded": [
    {
      "type": "thread.started",
      "thread_id": "01a1c000-0000-7000-8000-0000000000bb"
    },
    {
      "type": "turn.started"
    },
    {
      "type": "item.completed",
      "item": {
        "id": "item_0",
        "type": "agent_message",
        "text": "ok"
      }
    },
    {
      "type": "turn.completed",
      "usage": {
        "input_tokens": 10,
        "cached_input_tokens": 0,
        "output_tokens": 2,
        "reasoning_output_tokens": 0,
        "cache_write_input_tokens": 0
      }
    }
  ],
  "sdkThrew": null
}
