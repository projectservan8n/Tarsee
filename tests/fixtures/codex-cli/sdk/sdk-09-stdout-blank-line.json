{
  "name": "sdk-09-stdout-blank-line",
  "what": "An empty stdout line is a line like any other: it is not JSON, so the SDK throws on it.",
  "made_with": {
    "sdk": "@openai/codex-sdk 0.167.0, called directly",
    "platform": "win32"
  },
  "sdk": {
    "new Codex(options)": {
      "env": {},
      "codexPathOverride": "<CODEX_BIN>"
    },
    "thread": {
      "method": "startThread"
    },
    "runStreamed(input, turnOptions)": {
      "input": "hello",
      "inputLength": {
        "characters": 5,
        "utf8Bytes": 5
      },
      "turnOptions": {}
    },
    "callerProcessEnvNames": [
      "COMSPEC",
      "FROM_PROCESS_ENV",
      "NUMBER_OF_PROCESSORS",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP",
      "TMP",
      "TMPDIR"
    ]
  },
  "child": {
    "program": "<CODEX_BIN>",
    "argv": [
      "exec",
      "--experimental-json"
    ],
    "cwd": "<CALLER_CWD>",
    "envNames": [
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP"
    ],
    "envValues": {
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE": "codex_sdk_ts",
      "PATH": "C:\\WINDOWS\\system32;C:\\WINDOWS"
    },
    "envNamesNotInEnvOption": [
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP"
    ],
    "stdin": {
      "text": "hello",
      "sameAsTheInput": true,
      "bytes": 5,
      "chunks": [
        {
          "at_ms": 0,
          "bytes": 5
        }
      ],
      "eof_at_ms": 4
    }
  },
  "stub": {
    "stdout": "{\"type\":\"thread.started\",\"thread_id\":\"01a1c000-0000-7000-8000-0000000000bb\"}\n\n{\"type\":\"turn.started\"}\n",
    "stderr": "",
    "exitCode": 0,
    "sleepMsBeforeExit": 0
  },
  "sdkYielded": [
    {
      "type": "thread.started",
      "thread_id": "01a1c000-0000-7000-8000-0000000000bb"
    }
  ],
  "sdkThrew": {
    "name": "Error",
    "message": "Failed to parse item: ",
    "code": null,
    "cause": {
      "name": "SyntaxError",
      "message": "Unexpected end of JSON input"
    }
  }
}
