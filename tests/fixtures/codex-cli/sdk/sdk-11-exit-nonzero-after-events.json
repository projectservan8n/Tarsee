{
  "name": "sdk-11-exit-nonzero-after-events",
  "what": "Exit code 1 with text on stderr after a failed turn (what codex does): every event is yielded first, then the SDK throws `Codex Exec exited with code 1: <all of stderr>`.",
  "made_with": {
    "sdk": "@openai/codex-sdk 0.167.0, called directly",
    "platform": "win32"
  },
  "sdk": {
    "new Codex(options)": {
      "env": {},
      "codexPathOverride": "<CODEX_BIN>"
    },
    "thread": {
      "method": "startThread"
    },
    "runStreamed(input, turnOptions)": {
      "input": "hello",
      "inputLength": {
        "characters": 5,
        "utf8Bytes": 5
      },
      "turnOptions": {}
    },
    "callerProcessEnvNames": [
      "COMSPEC",
      "FROM_PROCESS_ENV",
      "NUMBER_OF_PROCESSORS",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP",
      "TMP",
      "TMPDIR"
    ]
  },
  "child": {
    "program": "<CODEX_BIN>",
    "argv": [
      "exec",
      "--experimental-json"
    ],
    "cwd": "<CALLER_CWD>",
    "envNames": [
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP"
    ],
    "envValues": {
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE": "codex_sdk_ts",
      "PATH": "C:\\WINDOWS\\system32;C:\\WINDOWS"
    },
    "envNamesNotInEnvOption": [
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "TEMP"
    ],
    "stdin": {
      "text": "hello",
      "sameAsTheInput": true,
      "bytes": 5,
      "chunks": [
        {
          "at_ms": 0,
          "bytes": 5
        }
      ],
      "eof_at_ms": 6
    }
  },
  "stub": {
    "stdout": "{\"type\":\"thread.started\",\"thread_id\":\"01a1c000-0000-7000-8000-0000000000bb\"}\n{\"type\":\"turn.started\"}\n{\"type\":\"error\",\"message\":\"boom\"}\n{\"type\":\"turn.failed\",\"error\":{\"message\":\"boom\"}}\n",
    "stderr": "Reading prompt from stdin...\nERROR something went wrong\n",
    "exitCode": 1,
    "sleepMsBeforeExit": 0
  },
  "sdkYielded": [
    {
      "type": "thread.started",
      "thread_id": "01a1c000-0000-7000-8000-0000000000bb"
    },
    {
      "type": "turn.started"
    },
    {
      "type": "error",
      "message": "boom"
    },
    {
      "type": "turn.failed",
      "error": {
        "message": "boom"
      }
    }
  ],
  "sdkThrew": {
    "name": "Error",
    "message": "Codex Exec exited with code 1: Reading prompt from stdin...\nERROR something went wrong\n",
    "code": null,
    "cause": null
  }
}
