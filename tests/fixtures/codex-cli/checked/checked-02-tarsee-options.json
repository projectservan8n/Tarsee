{
 "name": "checked-02-tarsee-options",
 "what": "Tarsee's own buildCodexOptions() for each provider, handed to the real SDK exactly as providers/codex.js run() hands it (new Codex({env, config, apiKey?}), startThread or resumeThread, runStreamed): the argument list, stdin and the environment the program got. The server's environment given had one of every kind of name the rules strip; the vault had a plain key, a CODEX_ name and an OPENAI_API_KEY.",
 "made_with": {
  "sdk": "@openai/codex-sdk 0.167.0, given what src/ai/providers/codex-options.js buildCodexOptions() returned",
  "stub": "scripts/checked-stub-exec.js.txt, run by node itself as the program",
  "script": "scripts/checked-capture.mjs.txt",
  "platform": "win32, Node 22.18"
 },
