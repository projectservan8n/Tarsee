{
  "name": "real-02-resumed-thread",
  "what": "The next turn on the same thread (`resume <thread id>`): thread.started carries the same id, and turn.completed's usage is the thread's running total (both turns'), not this turn's.",
  "made_with": {
    "program": "codex 0.167.0 (the real pinned program), started with the argument list, environment and stdin the SDK produced",
    "platform": "win32"
  },
  "child": {
    "program": "<CODEX_BIN>",
    "argv": [
      "--config",
      "sandbox_workspace_write.network_access=true",
      "--config",
      "web_search=\"disabled\"",
      "--config",
      "approval_policy=\"never\"",
      "resume",
      "<THREAD_ID>"
    ],
    "argvNote": "the last 8 arguments; the rest is the same as the new thread's",
    "stdin": "And again."
  },
